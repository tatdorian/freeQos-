# =============================================================================
# freeQoS - controleur QoS/QoE hors-bande
# Copier en .env et adapter. AUCUN secret ne doit etre commite.
# =============================================================================

# --- Application ---------------------------------------------------------
APP_ENV=lab
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# --- Base de donnees (TimescaleDB) ---------------------------------------
DATABASE_URL=postgresql://qos:changeme@timescaledb:5432/qos
DB_POOL_MIN=1
DB_POOL_MAX=8
DB_AUTO_MIGRATE=true

# Politiques Timescale (0 = desactive)
CHUNK_INTERVAL_HOURS=24
COMPRESSION_AFTER_DAYS=7
RETENTION_DAYS=90

# --- Scheduler (boucle CENTRALE lente) -----------------------------------
# La boucle LOCALE rapide vit sur le PoP et n'est PAS geree par cette app.
SCHEDULER_ENABLED=true
SUBSCRIBER_INTERVAL_S=10
BACKHAUL_INTERVAL_S=30
PLAN_REFRESH_INTERVAL_S=300

# --- Routeurs MikroTik ----------------------------------------------------
# Deux facons de declarer les routeurs, au choix :
#  1) ROUTERS_FILE pointe sur un YAML/JSON (recommande, cf config/routers.example.yml)
#  2) ROUTERS contient le JSON inline
ROUTERS_FILE=config/routers.yml
# ROUTERS=[{"name":"pop-nord","host":"10.10.0.11","username":"qos-ro","password_env":"MT_POP_NORD_PASSWORD","role":"pop"}]

# Les mots de passe sont lus depuis ces variables (champ password_env du routeur).
MT_POP_NORD_PASSWORD=
MT_POP_SUD_PASSWORD=

# --- Capacite backhaul (Ubiquiti / UISP) - LECTURE SEULE ------------------
# mock = simulateur pour le lab (aucune radio requise) ; uisp = API reelle
BACKHAUL_PROVIDER=mock
UISP_BASE_URL=https://uisp.exemple.net
UISP_TOKEN=
UISP_VERIFY_TLS=true
UISP_TIMEOUT_S=10

# Parametres du simulateur de capacite backhaul
MOCK_BACKHAUL_CAPACITY_MBPS=450
MOCK_BACKHAUL_VARIATION_PCT=35
MOCK_BACKHAUL_PERIOD_S=600
MOCK_BACKHAUL_SEED=1337

# --- Plans abonnes (RADIUS) ----------------------------------------------
# mock = plans simules ; freeradius_sql = lecture de la base FreeRADIUS
PLAN_PROVIDER=mock
RADIUS_DSN=postgresql://radius:changeme@10.10.0.5:5432/radius
RADIUS_RATE_ATTRIBUTE=Mikrotik-Rate-Limit
RADIUS_DEFAULT_DOWN_MBPS=100
RADIUS_DEFAULT_UP_MBPS=20

# --- Garde-fous ------------------------------------------------------------
# Phase 2 uniquement. Doit rester false : cette app ne pousse rien pour l'instant.
ENFORCEMENT_ENABLED=false
# Debit au dela duquel un echantillon est considere aberrant (compteur remis a zero)
MAX_PLAUSIBLE_BPS=100000000000

# --- docker-compose --------------------------------------------------------
TIMESCALE_IMAGE=timescale/timescaledb:latest-pg16
POSTGRES_USER=qos
POSTGRES_PASSWORD=changeme
POSTGRES_DB=qos
POSTGRES_PORT=5432
APP_PORT=8000
