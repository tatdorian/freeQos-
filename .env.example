# =============================================================================
# freeQoS - controleur QoS/QoE hors-bande
# Copier en .env et adapter. AUCUN secret ne doit etre commite.
# =============================================================================

# --- Application ---------------------------------------------------------
APP_ENV=lab
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# --- Base de donnees (TimescaleDB) ---------------------------------------
DATABASE_URL=postgresql://qos:changeme@timescaledb:5432/qos
DB_POOL_MIN=1
DB_POOL_MAX=8
DB_AUTO_MIGRATE=true

# Politiques Timescale (0 = desactive)
CHUNK_INTERVAL_HOURS=24
COMPRESSION_AFTER_DAYS=7
RETENTION_DAYS=90

# --- Scheduler (boucle CENTRALE lente) -----------------------------------
# La boucle LOCALE rapide vit sur le PoP et n'est PAS geree par cette app.
SCHEDULER_ENABLED=true
SUBSCRIBER_INTERVAL_S=10
BACKHAUL_INTERVAL_S=30
PLAN_REFRESH_INTERVAL_S=300
# Filet de securite : recharge l'inventaire meme si un PoP a ete ajoute par une
# autre instance ou directement en base. L'ajout via l'interface est pris en
# compte immediatement, sans attendre cette echeance.
INVENTORY_REFRESH_INTERVAL_S=60

# --- Sonde de latence (RTT) -----------------------------------------------
# LibreQoS mesure le RTT passivement en lisant les paquets ; hors-bande c'est
# impossible. La seule mesure accessible est une sonde ACTIVE /ping depuis le
# routeur, qui consomme du CPU : elle est donc desactivee par defaut.
# Le compte qos-ro doit avoir la politique 'test'.
RTT_ENABLED=false
RTT_INTERVAL_S=30
RTT_BATCH_SIZE=20
RTT_COUNT=2
RTT_MAX_AGE_S=300

# --- Cle de chiffrement ---------------------------------------------------
# Protege les mots de passe des routeurs AJOUTES DEPUIS L'INTERFACE (les autres
# gardent leurs secrets en variables d'environnement, cf. plus bas).
# Sans cette cle, l'API refuse d'enregistrer un PoP : elle n'ecrira jamais un
# mot de passe en clair dans PostgreSQL.
# Generer :  python -m app.services.crypto
APP_SECRET_KEY=

# --- Routeurs MikroTik ----------------------------------------------------
# Deux facons de declarer les routeurs, au choix :
#  1) ROUTERS_FILE pointe sur un YAML/JSON (recommande, cf config/routers.example.yml)
#  2) ROUTERS contient le JSON inline
ROUTERS_FILE=config/routers.yml
# ROUTERS=[{"name":"pop-nord","host":"10.10.0.11","username":"qos-ro","password_env":"MT_POP_NORD_PASSWORD","role":"pop"}]

# Les mots de passe sont lus depuis ces variables (champ password_env du routeur).
MT_POP_NORD_PASSWORD=
MT_POP_SUD_PASSWORD=

# --- Capacite backhaul (Ubiquiti / UISP) - LECTURE SEULE ------------------
# mock = simulateur pour le lab (aucune radio requise) ; uisp = API reelle
BACKHAUL_PROVIDER=mock
UISP_BASE_URL=https://uisp.exemple.net
UISP_TOKEN=
UISP_VERIFY_TLS=true
UISP_TIMEOUT_S=10

# Parametres du simulateur de capacite backhaul
MOCK_BACKHAUL_CAPACITY_MBPS=450
MOCK_BACKHAUL_VARIATION_PCT=35
MOCK_BACKHAUL_PERIOD_S=600
MOCK_BACKHAUL_SEED=1337

# --- Plans abonnes (RADIUS) ----------------------------------------------
# mock = plans simules ; freeradius_sql = lecture de la base FreeRADIUS
PLAN_PROVIDER=mock
RADIUS_DSN=postgresql://radius:changeme@10.10.0.5:5432/radius
RADIUS_RATE_ATTRIBUTE=Mikrotik-Rate-Limit
RADIUS_DEFAULT_DOWN_MBPS=100
RADIUS_DEFAULT_UP_MBPS=20

# --- Shaping / enforcement (phase 2) --------------------------------------
# DERNIER REMPART avant toute ecriture sur un routeur. A false, le controleur
# calcule et affiche les plans mais n'envoie jamais rien.
ENFORCEMENT_ENABLED=false

# On shape SOUS la capacite reelle du lien : c'est ce qui fait que la file se
# forme dans CAKE, ou on la controle, plutot que dans le buffer de la radio.
# Principe commun a Preseem et LibreQoS.
SHAPING_SAFETY_FACTOR=0.90
# Plancher : un fade profond ne doit pas couper le lien a zero.
SHAPING_FLOOR_MBPS=5
# Supprimer nos files devenues inutiles (abonne parti, lien retire).
# A passer a false pendant une migration.
SHAPING_PRUNE=true

# Encapsulation comptee par CAKE. PPPoE sur ethernet = 8 + 14 octets.
# Ajouter 4 par etiquette VLAN, 4 par label MPLS. Sous-estimer revient a shaper
# au-dessus de la capacite du lien, ce qui annule l'interet de l'AQM.
CAKE_OVERHEAD=22
CAKE_RTT_MS=50

# Coupe-circuit : un plan plus gros signale un etat desire mal calcule.
ENFORCEMENT_MAX_ACTIONS=500
TOPOLOGY_REFRESH_INTERVAL_S=900
# Debit au dela duquel un echantillon est considere aberrant (compteur remis a zero)
MAX_PLAUSIBLE_BPS=100000000000

# --- docker-compose --------------------------------------------------------
TIMESCALE_IMAGE=timescale/timescaledb:latest-pg16
POSTGRES_USER=qos
POSTGRES_PASSWORD=changeme
POSTGRES_DB=qos
POSTGRES_PORT=5432
APP_PORT=8000
